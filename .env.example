# API Keys for Clinical Intelligence Assistant
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# To Upload the Recordings to the GOOGLE DRIVE (as we don't have the AWS-S3 bucket access)
GDRIVE_WEBHOOK_URL=your_google_drive_webhook_url_here

# Optional Alternative LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Configuration
DATABASE_URL=your_postgres_url_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_db_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cliniq_db

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=10

# Gmail SMTP Configuration for OTP Delivery
# Use your Gmail address and a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_smpt_password_here
SMTP_FROM_NAME="ClinIQ Health Assistant"
