# Copy values into app/.env. Never commit real production secrets.

DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-chat

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinical-intelligence-agent

# PostgreSQL (one-click local via docker compose)
DB_USER=clinIQ_user
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cliniIQ
DATABASE_URL=postgresql://clinIQ_user:password@127.0.0.1:5432/cliniIQ

# S3 optional — leave empty to keep PDFs only on local disk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=clinical-visits
